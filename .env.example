# Copy to .env for local development (npm run dev); set the same names in Vercel (Settings → Environment Variables).
# .env is git-ignored. See README.md for what each one does.

# Required: the Song Studio and AI loops (Claude).
ANTHROPIC_API_KEY=

# Lyric sync (Groq's Whisper). Without it, lyric sync says it isn't set up; LRC import still works.
GROQ_API_KEY=

# Recommended until payments exist: the Studio, AI loops and lyric sync ask for this code once per browser.
STUDIO_ACCESS_CODE=

# Optional model settings.
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=low
# SHADER_EFFORT=low

# Daily limits per visitor (api/_lib/limits.js); access-code holders get PRO_LIMIT_FACTOR times as many.
# FREE_DAILY_LIMIT=5
# SHADER_DAILY_LIMIT=20
# LYRICS_DAILY_LIMIT=10
# PRO_LIMIT_FACTOR=10
# All AI requests per day across every visitor (a ceiling on the day's cost).
# AI_DAILY_LIMIT=

# Where the limits are counted on Vercel: Upstash Redis (Vercel → Storage → Upstash adds KV_REST_API_URL and
# KV_REST_API_TOKEN automatically). Without it, counts are kept per server instance only.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
